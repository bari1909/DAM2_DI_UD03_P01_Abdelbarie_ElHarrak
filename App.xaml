<Application x:Class="DAM2_DI_UD03_P01.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DAM2_DI_UD03_P01"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 4.4.4 D. Contraste Cromático Legal (WCAG 2.1 Nivel AA) -->
        <SolidColorBrush x:Key="BrushPrimario" Color="#0E5A7A"/>
        <SolidColorBrush x:Key="BrushPrimarioHover" Color="#0A4560"/>
        <SolidColorBrush x:Key="BrushFondo" Color="#F4F7F9"/>
        <SolidColorBrush x:Key="BrushTarjeta" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBorde" Color="#C9D3DB"/>
        <SolidColorBrush x:Key="BrushTexto" Color="#1F2933"/>
        <SolidColorBrush x:Key="BrushTextoSecundario" Color="#444F5A"/>
        <SolidColorBrush x:Key="BrushFilaActiva" Color="#F1F6F9"/>
        <SolidColorBrush x:Key="BrushPeligro" Color="#B91C1C"/>
        <SolidColorBrush x:Key="BrushExito" Color="#15803D"/>
        <SolidColorBrush x:Key="BrushFondoProgreso" Color="#E3EEF4"/>

        <!-- Badges o etiquetas visuales distintivas con el nombre del módulo y la prioridad -->
        <SolidColorBrush x:Key="BrushBadgeModuloFondo" Color="#E3EEF4"/>
        <SolidColorBrush x:Key="BrushBadgeModuloTexto" Color="#0A4560"/>
        <SolidColorBrush x:Key="BrushBadgeAltaFondo" Color="#FDE2E2"/>
        <SolidColorBrush x:Key="BrushBadgeAltaTexto" Color="#7F1D1D"/>
        <SolidColorBrush x:Key="BrushBadgeMediaFondo" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="BrushBadgeMediaTexto" Color="#78350F"/>
        <SolidColorBrush x:Key="BrushBadgeBajaFondo" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="BrushBadgeBajaTexto" Color="#14532D"/>

        <!-- 4.4.2 B. Operabilidad Total por Teclado -->
        <Style x:Key="EstiloFoco">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="8" RadiusY="8"
                                   Stroke="{StaticResource BrushTexto}"
                                   StrokeThickness="2" StrokeDashArray="2 2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Agrupado formalmente mediante un contenedor con borde y título -->
        <Style x:Key="EstiloTarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushTarjeta}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="EstiloTituloTarjeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        </Style>

        <Style x:Key="EstiloEtiqueta" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushTextoSecundario}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="6,0,8,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="6,0,8,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Agrupación semántica mediante GroupBox (Ley de Región Común) -->
        <Style x:Key="EstiloGrupo" TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            <ContentPresenter/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Diana táctil y dimensiones mínimas de botones interactivos (mínimo 36-44px) -->
        <Style x:Key="EstiloBotonPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushPrimario}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushPrimarioHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E3E9EE"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstiloBotonSecundario" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource BrushPrimario}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushPrimario}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushFilaActiva}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstiloBotonIcono" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushFilaActiva}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstiloBotonEliminar" TargetType="Button" BasedOn="{StaticResource EstiloBotonIcono}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource BrushPeligro}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FDE2E2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstiloBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
